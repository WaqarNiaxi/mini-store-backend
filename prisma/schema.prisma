generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String?
  password  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wallet          Wallet?
  orders          Order[]
  giftsSent       Gift[]   @relation("GiftsSent")
  giftsReceived   Gift[]   @relation("GiftsReceived")
  transfersSent   CreditTransfer[] @relation("TransfersSent")
  transfersRecv   CreditTransfer[] @relation("TransfersReceived")
  transactions    WalletTransaction[]
}


model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(1000.00)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}


model WalletTransaction {
  id          String   @id @default(uuid())
  userId      String
  type        TransactionType
  amount      Decimal
  description String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}


enum TransactionType {
  PURCHASE
  GIFT_SENT
  GIFT_RECEIVED
  TRANSFER_SENT
  TRANSFER_RECEIVED
}


model Product {
  id          String   @id
  title       String
  description String
  price       Decimal
  thumbnail   String
  createdAt   DateTime @default(now())

  orderItems  OrderItem[]
  gifts       Gift[]
}


model Order {
  id          String   @id @default(uuid())
  userId      String
  totalAmount Decimal
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  items       OrderItem[]
}



model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  price     Decimal
  quantity  Int      @default(1)

  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}



model Gift {
  id           String   @id @default(uuid())
  productId    String
  senderId     String
  recipientId  String
  createdAt    DateTime @default(now())

  product      Product @relation(fields: [productId], references: [id])
  sender       User    @relation("GiftsSent", fields: [senderId], references: [id])
  recipient    User    @relation("GiftsReceived", fields: [recipientId], references: [id])
}



model CreditTransfer {
  id           String   @id @default(uuid())
  senderId     String
  recipientId  String
  amount       Decimal
  createdAt    DateTime @default(now())

  sender       User @relation("TransfersSent", fields: [senderId], references: [id])
  recipient    User @relation("TransfersReceived", fields: [recipientId], references: [id])
}

